<Window x:Class="DayTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DayTodo.ViewModels"
        Title="DayTodo 日清单"
        Width="980" Height="680" MinWidth="780" MinHeight="540"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
            <Border Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0.5"
                    CornerRadius="8" Padding="10,9" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="3" CornerRadius="1.5" Margin="0,0,10,0"
                            Background="{Binding PriorityBrush}" />

                    <Button Grid.Column="1" Style="{StaticResource CheckButton}"
                            Command="{Binding ToggleCommand}" VerticalAlignment="Center">
                        <Grid Width="18" Height="18">
                            <Ellipse Fill="{Binding CheckFill}" Stroke="{Binding CheckBorder}" StrokeThickness="1.4" />
                            <Path Data="M 3,9 L 6.5,12.3 L 13,4.6" Stroke="#FFFFFF" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </Button>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Background="{Binding BadgeBack}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding BadgeText}" FontSize="10.5" Foreground="{Binding BadgeFore}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource ChipBrush}" CornerRadius="4"
                                                Padding="6,1" Margin="0,0,5,0">
                                            <TextBlock Text="{Binding}" FontSize="10.5"
                                                       Foreground="{StaticResource TextSecondary}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding PriorityText}" FontSize="10.5"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="拉回今天" Style="{StaticResource RowActionButton}"
                                Command="{Binding BringToTodayCommand}"
                                ToolTip="把这条未来任务移回今天"
                                Visibility="{Binding CanBringToToday, Converter={StaticResource BoolVis}}" />
                        <Button Content="改期" Style="{StaticResource RowActionButton}" Margin="6,0,0,0"
                                Command="{Binding MoveCommand}"
                                ToolTip="移动到今天或未来的某一天"
                                Visibility="{Binding CanMove, Converter={StaticResource BoolVis}}" />
                        <Button Content="删除" Style="{StaticResource DeleteButton}" Margin="8,0,0,0"
                                Command="{Binding DeleteCommand}"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="#DDDBD4" BorderThickness="0.5" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource PanelBrush}"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Grid.ColumnSpan="2" Height="0.5" VerticalAlignment="Bottom"
                        Background="#E8E6E0" />

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource Accent}">
                        <Path Data="M 3.5,9.3 L 6.6,12.2 L 13.5,5" Stroke="#FFFFFF" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <TextBlock Text="DayTodo 日清单" FontSize="12.5" Margin="9,0,0,0"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Style="{StaticResource TitleBarButton}" Click="Settings_Click" ToolTip="设置">
                        <Canvas Width="14" Height="14">
                            <Rectangle Canvas.Left="0" Canvas.Top="2" Width="14" Height="1.3" Fill="#5F5E5A" />
                            <Rectangle Canvas.Left="0" Canvas.Top="6.4" Width="14" Height="1.3" Fill="#5F5E5A" />
                            <Rectangle Canvas.Left="0" Canvas.Top="10.8" Width="14" Height="1.3" Fill="#5F5E5A" />
                            <Border Canvas.Left="3" Canvas.Top="0.4" Width="2.6" Height="4.5"
                                    CornerRadius="1.3" Background="#5F5E5A" />
                            <Border Canvas.Left="8" Canvas.Top="4.8" Width="2.6" Height="4.5"
                                    CornerRadius="1.3" Background="#5F5E5A" />
                            <Border Canvas.Left="5" Canvas.Top="9.2" Width="2.6" Height="4.5"
                                    CornerRadius="1.3" Background="#5F5E5A" />
                        </Canvas>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="最小化">
                        <Rectangle Width="11" Height="1" Fill="#5F5E5A" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="Maximize_Click" ToolTip="最大化 / 还原">
                        <Rectangle Width="10" Height="10" Stroke="#5F5E5A" StrokeThickness="1" Fill="Transparent" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="最小化到托盘">
                        <Path Data="M 1,1 L 10,10 M 10,1 L 1,10" Stroke="#5F5E5A" StrokeThickness="1.1" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                    <Grid Margin="12,14,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Calendar Grid.Row="0"
                                  SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                  DisplayDate="{Binding SelectedDate}"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource TextPrimary}"
                                  FontSize="11" HorizontalAlignment="Stretch" />

                        <StackPanel Grid.Row="1" Margin="2,14,2,0">
                            <Rectangle Height="0.5" Fill="#E8E6E0" />
                            <TextBlock Text="今日概览" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       Margin="0,12,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DoneCount}" FontSize="22" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Bottom" Margin="4,0,0,3">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{} / {0} 项完成">
                                            <Binding Path="TotalCount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="顺延任务" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" FontSize="11.5" Foreground="#BA7517">
                                    <TextBlock.Text>
                                        <Binding Path="CarryCount" StringFormat="{}{0} 项" />
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="连续记录" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{StaticResource AccentDark}">
                                    <TextBlock.Text>
                                        <Binding Path="StreakDays" StringFormat="{}{0} 天" />
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,7,0,0"
                                  Visibility="{Binding HasFutureTasks, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="未来安排" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                <Button Grid.Column="1" Style="{StaticResource LinkButton}"
                                        Command="{Binding GoToFutureCommand}"
                                        ToolTip="跳到最近的未来安排日，可把任务拉回今天">
                                    <TextBlock FontSize="11.5">
                                        <TextBlock.Text>
                                            <Binding Path="FutureCount" StringFormat="{}{0} 项 · 查看" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                            <Rectangle Height="0.5" Fill="#E8E6E0" />

                            <!-- 左栏只保留一件事：MCP 服务。其余操作都收进了「设置」。 -->
                            <Border Margin="2,12,0,0" Background="#FFFFFF" BorderBrush="#E3E1DA"
                                    BorderThickness="0.5" CornerRadius="8" Padding="10,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="MCP 服务" FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding McpStatusText}" FontSize="10" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="McpSwitch" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              Checked="McpSwitch_Changed" Unchecked="McpSwitch_Changed"
                                              ToolTip="开启后 AI 客户端可通过 http://127.0.0.1:8765/mcp 创建任务" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,16,20,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDateText}" FontSize="19" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <Border Background="{StaticResource AccentLight}" CornerRadius="4" Padding="6,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsToday, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="今天" FontSize="10.5" Foreground="{StaticResource AccentDark}" />
                                </Border>
                                <Border Background="{StaticResource ChipBrush}" CornerRadius="4" Padding="6,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsHistory, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="历史" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                                </Border>
                                <Border Background="{StaticResource AccentLight}" CornerRadius="4" Padding="6,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsFuture, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="计划" FontSize="10.5" Foreground="{StaticResource AccentDark}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource NavButton}" Command="{Binding PrevDayCommand}" ToolTip="前一天">
                                    <Path Data="M 6,1 L 2,6 L 6,11" Stroke="#5F5E5A" StrokeThickness="1.3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                                <Button Style="{StaticResource NavButton}" Command="{Binding NextDayCommand}" Margin="6,0,0,0" ToolTip="后一天">
                                    <Path Data="M 2,1 L 6,6 L 2,11" Stroke="#5F5E5A" StrokeThickness="1.3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                                <Button Style="{StaticResource TodayButton}" Height="28" Margin="6,0,0,0"
                                        Command="{Binding TodayCommand}" Content="回到今天" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding SummaryText}" FontSize="11.5"
                                   Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />

                        <!-- Progress is a computed read-only property. ProgressBar.Value binds
                             TwoWay by default, so an explicit OneWay mode is required. -->
                        <ProgressBar Height="3" Margin="0,13,0,0" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                     Foreground="{StaticResource Accent}" Background="{StaticResource LineBrush}"
                                     BorderThickness="0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="20,12,20,8">
                        <ListBox ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource TaskListItem}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasNoTasks, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="这一天还没有任务" FontSize="13" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="在下方输入框添加" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Background="#FCFCFB" MinHeight="96">
                        <Border Height="0.5" VerticalAlignment="Top" Background="#E8E6E0" />

                        <Grid Margin="20,10" Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Full-width, visibly bordered input. Clicking anywhere focuses the TextBox. -->
                            <Border Grid.Row="0" Grid.Column="0" Height="38"
                                    BorderBrush="#DCDAD2" BorderThickness="1" CornerRadius="6"
                                    Background="#FFFFFF" Cursor="IBeam"
                                    MouseLeftButtonDown="InputArea_MouseDown">
                                <Grid>
                                    <TextBox x:Name="TitleBox" Style="{StaticResource PlainTextBox}"
                                             Padding="12,0" VerticalAlignment="Stretch"
                                             Text="{Binding NewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="TitleBox_TextChanged"
                                             KeyDown="TitleBox_KeyDown"
                                             ToolTip="输入任务后按回车添加" />
                                    <TextBlock Text="添加任务，回车保存" FontSize="13" Margin="13,0,0,0"
                                               Foreground="{StaticResource TextMuted}" IsHitTestVisible="False"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Visibility="{Binding TitleHintVisible, Converter={StaticResource BoolVis}}" />
                                </Grid>
                            </Border>

                            <Button x:Name="AddButton" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0"
                                    Width="78" Height="38" Content="添加" Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanAdd}" Command="{Binding AddCommand}" />

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="标签" FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" Margin="2,0,8,0" />
                                <TextBox Width="200" Height="28" FontSize="11.5"
                                         Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                         Background="#FFFFFF" BorderBrush="#E3E1DA" BorderThickness="1"
                                         Padding="8,0" VerticalContentAlignment="Center"
                                         Text="{Binding NewTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="标签，用逗号分隔，最多 4 个" />

                                <TextBlock Text="优先级" FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" Margin="16,0,8,0" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource DotButton}" Background="#E24B4A"
                                            BorderBrush="{Binding HighRing}" ToolTip="高优先级"
                                            Command="{Binding SetPriorityCommand}" CommandParameter="2" />
                                    <Button Style="{StaticResource DotButton}" Background="#EF9F27" Margin="6,0,0,0"
                                            BorderBrush="{Binding NormalRing}" ToolTip="中优先级"
                                            Command="{Binding SetPriorityCommand}" CommandParameter="1" />
                                    <Button Style="{StaticResource DotButton}" Background="#C9C7BE" Margin="6,0,0,0"
                                            BorderBrush="{Binding LowRing}" ToolTip="低优先级"
                                            Command="{Binding SetPriorityCommand}" CommandParameter="0" />
                                </StackPanel>
                                <TextBlock Text="回车即可添加" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11.5"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="这一天是历史记录，只能查看，不能新增、勾选或删除"
                                   Visibility="{Binding IsHistory, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
