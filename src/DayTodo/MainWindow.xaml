<Window x:Class="DayTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DayTodo.ViewModels"
        xmlns:views="clr-namespace:DayTodo.Views"
        xmlns:local="clr-namespace:DayTodo"
        Title="DayTodo 日清单"
        Width="980" Height="680" MinWidth="780" MinHeight="540"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#FFFFFF" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:EmptyTextToVisibilityConverter x:Key="EmptyTextVis" />

        <!-- 搜索结果：日期分隔行 -->
        <DataTemplate DataType="{x:Type vm:SearchGroupHeader}">
            <Grid Margin="0,12,0,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Text="{Binding CountText}" FontSize="11" Margin="8,0,0,0"
                               Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 搜索结果：只读命中行，跳转按钮走原始日期视图 -->
        <DataTemplate DataType="{x:Type vm:SearchHit}">
            <Border Background="#FFFFFF" BorderBrush="#E8E6E0" BorderThickness="0.5"
                    CornerRadius="8" Padding="9,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="#F5F9FE" />
                                <Setter Property="BorderBrush" Value="#85B7EB" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" CornerRadius="1.5" Margin="0,1,10,1"
                            Background="{Binding BarBrush}" />
                    <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                Cursor="Hand" PreviewMouseLeftButtonDown="SearchHit_Click">
                        <TextBlock FontSize="12.5" Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   local:SearchHighlight.Text="{Binding Text}"
                                   local:SearchHighlight.Query="{Binding Query}" />
                        <TextBlock Text="{Binding MetaText}" FontSize="10.5" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="跳转" Style="{StaticResource LinkButton}"
                            Command="{Binding OpenCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="SearchChip" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#5F5E5A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" Background="#F1EFE8" CornerRadius="4" Padding="9,4"
                                Cursor="Hand">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#E6F1FB" />
                                <Setter Property="Foreground" Value="#185FA5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:TaskRowViewModel}">
            <Border x:Name="RowCard" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0.5"
                    CornerRadius="8" Padding="10,9" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="3" CornerRadius="1.5" Margin="0,0,10,0"
                            Background="{Binding PriorityBrush}" />

                    <Button Grid.Column="1" Style="{StaticResource CheckButton}"
                            Command="{Binding ToggleCommand}" VerticalAlignment="Center">
                        <Grid Width="18" Height="18">
                            <Ellipse Fill="{Binding CheckFill}" Stroke="{Binding CheckBorder}" StrokeThickness="1.4" />
                            <Path Data="M 3,9 L 6.5,12.3 L 13,4.6" Stroke="#FFFFFF" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="{Binding IsDone, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </Button>

                    <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource TaskBodyButton}"
                            Click="TaskBody_Click">
                        <StackPanel VerticalAlignment="Center">
                            <!-- A Grid, not a horizontal StackPanel: only a * column gives the
                                 title a real width, and only then does TextTrimming cut it off. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TitleText" Grid.Column="0"
                                           Text="{Binding Title}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           views:TextTrimWatcher.Monitor="True">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Hover affordance for trimmed titles only. It overlays the end
                                     of the line instead of taking space, so the row never jumps. -->
                                <Border Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="#F6F5F1" Padding="8,1,0,1" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTruncated}" Value="True" />
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                   Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="点击查看全文" FontSize="10.5"
                                               Foreground="{StaticResource AccentDark}" />
                                </Border>

                                <Border Grid.Column="1" Background="{Binding BadgeBack}" CornerRadius="4"
                                        Padding="6,2" Margin="8,0,0,0"
                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="10.5" Foreground="{Binding BadgeFore}" />
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource ChipBrush}" CornerRadius="4"
                                                    Padding="6,1" Margin="0,0,5,0">
                                                <TextBlock Text="{Binding}" FontSize="10.5"
                                                           Foreground="{StaticResource TextSecondary}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding PriorityText}" FontSize="10.5"
                                           Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="拉回今天" Style="{StaticResource RowActionButton}"
                                Command="{Binding BringToTodayCommand}"
                                ToolTip="把这条未来任务移回今天"
                                Visibility="{Binding CanBringToToday, Converter={StaticResource BoolVis}}" />
                        <Button Content="改期" Style="{StaticResource RowActionButton}" Margin="6,0,0,0"
                                Command="{Binding MoveCommand}"
                                ToolTip="移动到今天或未来的某一天"
                                Visibility="{Binding CanMove, Converter={StaticResource BoolVis}}" />
                        <Button Content="撤回" Style="{StaticResource RowActionButton}" Margin="6,0,0,0"
                                Command="{Binding RecallCommand}"
                                ToolTip="撤回这条计划，放回下方编辑框，可修改后重新发送"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}" />
                        <Button Content="删除" Style="{StaticResource DeleteButton}" Margin="8,0,0,0"
                                Command="{Binding DeleteCommand}"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NoteRowViewModel}">
            <Border x:Name="RowCard" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0.5"
                    CornerRadius="8" Padding="12,10" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 折叠开关留在正文列内：放进右侧按钮列会改变正文宽度，
                         测量出来的「是否超过三行」就会随按钮出现而翻转。 -->
                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" />
                        <Button Grid.Column="1" Content="{Binding FoldText}" Style="{StaticResource LinkButton}"
                                Command="{Binding ToggleFoldCommand}" Margin="0,-2,0,0"
                                ToolTip="长随记折叠为三行，点击展开或收起"
                                Visibility="{Binding CanFold, Converter={StaticResource BoolVis}}" />
                    </Grid>

                    <!-- Capped, not fixed: a short note stays one or two lines tall. -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Text}" FontSize="12.5"
                               Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="57" VerticalAlignment="Top"
                               Margin="0,6,0,0" LineHeight="19"
                               views:NoteFoldWatcher.Monitor="True"
                               views:NoteFoldWatcher.MaxVisibleHeight="57"
                               Visibility="{Binding IsCollapsed, Converter={StaticResource BoolVis}}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Text}" FontSize="12.5"
                               Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"
                               Margin="0,6,0,0" LineHeight="19"
                               Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}" />

                    <ItemsControl Grid.Row="2" Grid.Column="0" ItemsSource="{Binding Quotes}"
                                  Margin="0,9,0,0"
                                  Visibility="{Binding HasQuotes, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AccentLight}" CornerRadius="4"
                                        Padding="7,3" Margin="0,0,6,4">
                                    <Button Style="{StaticResource QuoteChipButton}"
                                            Command="{Binding OpenCommand}"
                                            ToolTip="跳到被引用的那一天">
                                        <TextBlock FontSize="10.5" Foreground="{StaticResource AccentDark}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}引用 {0} · {1}">
                                                    <Binding Path="DateText" />
                                                    <Binding Path="Text" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- @ 引用的待办：与引用随记同一行式，但用中性色区分。 -->
                    <ItemsControl Grid.Row="3" Grid.Column="0" ItemsSource="{Binding TaskLinks}"
                                  Margin="0,9,0,0"
                                  Visibility="{Binding HasTaskLinks, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F1EFE8" CornerRadius="4"
                                        Padding="7,3" Margin="0,0,6,4">
                                    <Button Style="{StaticResource QuoteChipButton}"
                                            Command="{Binding OpenCommand}"
                                            ToolTip="跳到这条待办所在的那一天">
                                        <TextBlock FontSize="10.5" Foreground="#5F5E5A">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}待办 {0} · {1}">
                                                    <Binding Path="DayText" />
                                                    <Binding Path="Text" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="4" Orientation="Horizontal"
                                VerticalAlignment="Top" Margin="10,0,0,0">
                        <Button Content="引用" Style="{StaticResource RowActionButton}"
                                Command="{Binding QuoteCommand}" ToolTip="跳回今天，把这条随记放进引用" />
                        <Button Content="编辑" Style="{StaticResource RowActionButton}" Margin="6,0,0,0"
                                Command="{Binding EditCommand}"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}" />
                        <Button Content="删除" Style="{StaticResource DeleteButton}" Margin="8,0,0,0"
                                Command="{Binding DeleteCommand}"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="#DDDBD4" BorderThickness="0.5" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource PanelBrush}"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Grid.ColumnSpan="2" Height="0.5" VerticalAlignment="Bottom"
                        Background="#E8E6E0" />

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource Accent}">
                        <Path Data="M 3.5,9.3 L 6.6,12.2 L 13.5,5" Stroke="#FFFFFF" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <TextBlock Text="DayTodo 日清单" FontSize="12.5" Margin="9,0,0,0"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Style="{StaticResource TitleBarButton}" Click="Settings_Click" ToolTip="设置">
                        <Canvas Width="14" Height="14">
                            <Rectangle Canvas.Left="0" Canvas.Top="2" Width="14" Height="1.3" Fill="#5F5E5A" />
                            <Rectangle Canvas.Left="0" Canvas.Top="6.4" Width="14" Height="1.3" Fill="#5F5E5A" />
                            <Rectangle Canvas.Left="0" Canvas.Top="10.8" Width="14" Height="1.3" Fill="#5F5E5A" />
                            <Border Canvas.Left="3" Canvas.Top="0.4" Width="2.6" Height="4.5"
                                    CornerRadius="1.3" Background="#5F5E5A" />
                            <Border Canvas.Left="8" Canvas.Top="4.8" Width="2.6" Height="4.5"
                                    CornerRadius="1.3" Background="#5F5E5A" />
                            <Border Canvas.Left="5" Canvas.Top="9.2" Width="2.6" Height="4.5"
                                    CornerRadius="1.3" Background="#5F5E5A" />
                        </Canvas>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="最小化">
                        <Rectangle Width="11" Height="1" Fill="#5F5E5A" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="Maximize_Click" ToolTip="最大化 / 还原">
                        <Rectangle Width="10" Height="10" Stroke="#5F5E5A" StrokeThickness="1" Fill="Transparent" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="最小化到托盘">
                        <Path Data="M 1,1 L 10,10 M 10,1 L 1,10" Stroke="#5F5E5A" StrokeThickness="1.1" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                    <Grid Margin="12,14,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Calendar Grid.Row="0"
                                  SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                  DisplayDate="{Binding SelectedDate}"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource TextPrimary}"
                                  FontSize="11" HorizontalAlignment="Stretch" />

                        <StackPanel Grid.Row="1" Margin="2,14,2,0">
                            <Rectangle Height="0.5" Fill="#E8E6E0" />
                            <TextBlock Text="今日概览" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       Margin="0,12,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DoneCount}" FontSize="22" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Bottom" Margin="4,0,0,3">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{} / {0} 项完成">
                                            <Binding Path="TotalCount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="顺延任务" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" FontSize="11.5" Foreground="#BA7517">
                                    <TextBlock.Text>
                                        <Binding Path="CarryCount" StringFormat="{}{0} 项" />
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="连续记录" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{StaticResource AccentDark}">
                                    <TextBlock.Text>
                                        <Binding Path="StreakDays" StringFormat="{}{0} 天" />
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,7,0,0"
                                  Visibility="{Binding HasFutureTasks, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="未来安排" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                <Button Grid.Column="1" Style="{StaticResource LinkButton}"
                                        Command="{Binding GoToFutureCommand}"
                                        ToolTip="跳到最近的未来安排日，可把任务拉回今天">
                                    <TextBlock FontSize="11.5">
                                        <TextBlock.Text>
                                            <Binding Path="FutureCount" StringFormat="{}{0} 项 · 查看" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                            <Rectangle Height="0.5" Fill="#E8E6E0" />

                            <!-- 左栏只保留一件事：MCP 服务。其余操作都收进了「设置」。 -->
                            <Border Margin="2,12,0,0" Background="#FFFFFF" BorderBrush="#E3E1DA"
                                    BorderThickness="0.5" CornerRadius="8" Padding="10,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="MCP 服务" FontSize="11.5"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding McpStatusText}" FontSize="10" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="McpSwitch" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              Checked="McpSwitch_Changed" Unchecked="McpSwitch_Changed"
                                              ToolTip="开启后 AI 客户端可通过 http://127.0.0.1:8765/mcp 创建任务" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,10,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Button Content="任务" Style="{StaticResource TabButton}"
                                    Command="{Binding ShowTasksCommand}" HorizontalAlignment="Center" />
                            <Grid Height="2" Margin="8,1,8,0">
                                <Border Background="{StaticResource Accent}" CornerRadius="1"
                                        Visibility="{Binding IsTasksTab, Converter={StaticResource BoolVis}}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0">
                            <Button Content="随记" Style="{StaticResource TabButton}"
                                    Command="{Binding ShowNotesCommand}" HorizontalAlignment="Center" />
                            <Grid Height="2" Margin="8,1,8,0">
                                <Border Background="{StaticResource Accent}" CornerRadius="1"
                                        Visibility="{Binding IsNotesTab, Converter={StaticResource BoolVis}}" />
                            </Grid>
                        </StackPanel>

                        <!-- 常驻搜索入口：聚焦即进入搜索，Ctrl+F 也能到这里 -->
                        <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="200" Height="30" Background="#FFFFFF"
                                BorderBrush="#DCDAD2" BorderThickness="0.5" CornerRadius="6"
                                Margin="0,2,0,0">
                            <Grid Margin="8,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="#888780" StrokeThickness="1.3"
                                      Data="M6,1 A5,5 0 1,1 6,11 A5,5 0 1,1 6,1 Z M9.5,9.5 L13,13" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="7,0,4,0"
                                         Style="{StaticResource PlainTextBox}" FontSize="11.5"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         GotFocus="SearchBox_GotFocus"
                                         ToolTip="搜索任务与随记（Ctrl+F）" />
                                <TextBlock Grid.Column="1" Text="搜索任务 / 随记" FontSize="11.5"
                                           Foreground="#888780" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="7,0,4,0"
                                           Visibility="{Binding SearchText, Converter={StaticResource EmptyTextVis}}" />
                                <Button Grid.Column="2" Content="×" Style="{StaticResource LinkButton}"
                                        FontSize="13" Padding="2,0" Command="{Binding CloseSearchCommand}"
                                        ToolTip="退出搜索" />
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="20,8,20,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDateText}" FontSize="19" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <Border Background="{StaticResource AccentLight}" CornerRadius="4" Padding="6,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsToday, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="今天" FontSize="10.5" Foreground="{StaticResource AccentDark}" />
                                </Border>
                                <Border Background="{StaticResource ChipBrush}" CornerRadius="4" Padding="6,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsHistory, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="历史" FontSize="10.5" Foreground="{StaticResource TextSecondary}" />
                                </Border>
                                <Border Background="{StaticResource AccentLight}" CornerRadius="4" Padding="6,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsFuture, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="计划" FontSize="10.5" Foreground="{StaticResource AccentDark}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource NavButton}" Command="{Binding PrevDayCommand}" ToolTip="前一天">
                                    <Path Data="M 6,1 L 2,6 L 6,11" Stroke="#5F5E5A" StrokeThickness="1.3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                                <Button Style="{StaticResource NavButton}" Command="{Binding NextDayCommand}" Margin="6,0,0,0" ToolTip="后一天">
                                    <Path Data="M 2,1 L 6,6 L 2,11" Stroke="#5F5E5A" StrokeThickness="1.3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                                <Button Style="{StaticResource TodayButton}" Height="28" Margin="6,0,0,0"
                                        Command="{Binding TodayCommand}" Content="回到今天" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding HeaderSummaryText}" FontSize="11.5"
                                   Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />

                        <!-- Progress is a computed read-only property. ProgressBar.Value binds
                             TwoWay by default, so an explicit OneWay mode is required. -->
                        <ProgressBar Height="3" Margin="0,13,0,0" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                     Foreground="{StaticResource Accent}" Background="{StaticResource LineBrush}"
                                     BorderThickness="0"
                                     Visibility="{Binding ShowTaskProgress, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="20,12,20,8">
                        <Grid Visibility="{Binding IsTasksTab, Converter={StaticResource BoolVis}}">
                            <ListBox x:Name="TaskList" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource TaskListItem}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoTasks, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="这一天还没有任务" FontSize="13" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="在下方输入框添加" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding IsNotesTab, Converter={StaticResource BoolVis}}">
                            <ListBox x:Name="NoteList" ItemsSource="{Binding Notes}" ItemContainerStyle="{StaticResource NoteListItem}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoNotes, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="这一天还没有随记" FontSize="13" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="把此刻的想法随手记下来" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" Background="#FCFCFB" MinHeight="96">
                        <Border Height="0.5" VerticalAlignment="Top" Background="#E8E6E0" />

                        <Grid Visibility="{Binding IsTasksTab, Converter={StaticResource BoolVis}}">
                        <Grid Margin="20,10" Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 撤回提示：编辑框里现在是撤回回来的内容，改完可以重新发。 -->
                            <StackPanel x:Name="RecallHint" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,0,0,7"
                                        Visibility="{Binding HasRecalledDraft, Converter={StaticResource BoolVis}}">
                                <Border Background="{StaticResource AccentLight}" CornerRadius="4"
                                        Padding="7,2" VerticalAlignment="Center">
                                    <TextBlock Text="撤回" FontSize="10.5" Foreground="{StaticResource AccentDark}" />
                                </Border>
                                <TextBlock Text="{Binding RecalledHintText}" FontSize="11" Margin="7,0,0,0"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Full-width, visibly bordered input. Clicking anywhere focuses the TextBox. -->
                            <Border Grid.Row="1" Grid.Column="0" Height="38"
                                    BorderBrush="#DCDAD2" BorderThickness="1" CornerRadius="6"
                                    Background="#FFFFFF" Cursor="IBeam"
                                    MouseLeftButtonDown="InputArea_MouseDown">
                                <Grid>
                                    <TextBox x:Name="TitleBox" Style="{StaticResource PlainTextBox}"
                                             Padding="12,0" VerticalAlignment="Stretch"
                                             Text="{Binding NewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="TitleBox_TextChanged"
                                             KeyDown="TitleBox_KeyDown"
                                             ToolTip="输入任务后按回车添加" />
                                    <TextBlock Text="添加任务，回车保存" FontSize="13" Margin="13,0,0,0"
                                               Foreground="{StaticResource TextMuted}" IsHitTestVisible="False"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Visibility="{Binding TitleHintVisible, Converter={StaticResource BoolVis}}" />
                                </Grid>
                            </Border>

                            <Button x:Name="AddButton" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0"
                                    Width="78" Height="38" Content="添加" Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanAdd}" Command="{Binding AddCommand}" />

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="标签" FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" Margin="2,0,8,0" />
                                <TextBox Width="200" Height="28" FontSize="11.5"
                                         Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                         Background="#FFFFFF" BorderBrush="#E3E1DA" BorderThickness="1"
                                         Padding="8,0" VerticalContentAlignment="Center"
                                         Text="{Binding NewTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="标签，用逗号分隔，最多 4 个" />

                                <TextBlock Text="优先级" FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" Margin="16,0,8,0" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource DotButton}" Background="#E24B4A"
                                            BorderBrush="{Binding HighRing}" ToolTip="高优先级"
                                            Command="{Binding SetPriorityCommand}" CommandParameter="2" />
                                    <Button Style="{StaticResource DotButton}" Background="#EF9F27" Margin="6,0,0,0"
                                            BorderBrush="{Binding NormalRing}" ToolTip="中优先级"
                                            Command="{Binding SetPriorityCommand}" CommandParameter="1" />
                                    <Button Style="{StaticResource DotButton}" Background="#C9C7BE" Margin="6,0,0,0"
                                            BorderBrush="{Binding LowRing}" ToolTip="低优先级"
                                            Command="{Binding SetPriorityCommand}" CommandParameter="0" />
                                </StackPanel>
                                <TextBlock Text="回车即可添加" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" Margin="14,0,0,0" />
                            </StackPanel>
                        </Grid>
                        </Grid>

                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11.5"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="这一天是历史记录，只能查看，不能新增、勾选或删除"
                                   Visibility="{Binding IsHistory, Converter={StaticResource BoolVis}}" />

                        <!-- 随记编辑区：只有真正的今天才会渲染输入框。 -->
                        <Grid Visibility="{Binding IsNotesTab, Converter={StaticResource BoolVis}}">
                            <Grid Margin="20,10" Visibility="{Binding CanWriteNote, Converter={StaticResource BoolVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="NoteEditHint" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Margin="0,0,0,7"
                                            Visibility="{Binding IsEditingNote, Converter={StaticResource BoolVis}}">
                                    <Border Background="{StaticResource AccentLight}" CornerRadius="4"
                                            Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="编辑" FontSize="10.5" Foreground="{StaticResource AccentDark}" />
                                    </Border>
                                    <TextBlock Text="{Binding NoteEditorHintText}" FontSize="11" Margin="7,0,0,0"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <Button Content="取消编辑" Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                            Command="{Binding CancelNoteEditCommand}" />
                                </StackPanel>

                                <Border Grid.Row="1" Grid.Column="0" Height="66"
                                        BorderBrush="#DCDAD2" BorderThickness="1" CornerRadius="6"
                                        Background="#FFFFFF" Cursor="IBeam"
                                        MouseLeftButtonDown="NoteInputArea_MouseDown">
                                    <Grid>
                                        <TextBox x:Name="NoteBox" Style="{StaticResource PlainTextBox}"
                                                 Padding="12,9" VerticalAlignment="Stretch"
                                                 VerticalContentAlignment="Top" TextWrapping="Wrap"
                                                 AcceptsReturn="True" FontSize="12.5"
                                                 Text="{Binding NewNoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewKeyDown="NoteBox_KeyDown"
                                                 TextChanged="NoteBox_TextChanged"
                                                 PreviewMouseDown="NoteBox_PreviewMouseDown"
                                                 LostKeyboardFocus="NoteBox_LostKeyboardFocus"
                                                 ToolTip="随手记下想法，回车保存，Shift+Enter 换行，输入 @ 引用今天或昨天的待办" />
                                        <TextBlock Text="随手记下现在的想法…输入 @ 可引用今天或昨天的待办" FontSize="12.5" Margin="13,10,0,0"
                                                   Foreground="{StaticResource TextMuted}" IsHitTestVisible="False"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Visibility="{Binding NoteHintVisible, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                </Border>

                                <Button x:Name="SaveNoteButton" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0"
                                        Width="78" Height="66" Content="保存" Style="{StaticResource PrimaryButton}"
                                        IsEnabled="{Binding CanSaveNote}" Command="{Binding SaveNoteCommand}" />

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Enter 保存 · Shift+Enter 换行 · @ 引用待办" FontSize="10.5"
                                               Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Text="{Binding PendingQuoteText}" FontSize="10.5" Margin="16,0,0,0"
                                               Foreground="{StaticResource AccentDark}"
                                               Visibility="{Binding HasPendingQuotes, Converter={StaticResource BoolVis}}" />
                                    <Button Content="清除引用" Style="{StaticResource LinkButton}" Margin="8,0,0,0"
                                            Command="{Binding ClearQuotesCommand}"
                                            Visibility="{Binding HasPendingQuotes, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11.5"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="{Binding NoteReadOnlyText}"
                                       Visibility="{Binding NoteReadOnlyVisible, Converter={StaticResource BoolVis}}" />

                            <!-- @ 引用弹层：只列今天和昨天的待办，键盘上下选、回车确认。 -->
                            <Popup x:Name="MentionPopup" PlacementTarget="{Binding ElementName=NoteBox}"
                                   Placement="Top" VerticalOffset="-6" StaysOpen="True"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border x:Name="MentionPanel" Background="#FFFFFF" BorderBrush="#DCDAD2"
                                        BorderThickness="1" CornerRadius="6" Padding="4" Width="360">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12"
                                                          Color="#2C2C2A" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="引用今天或昨天的待办" FontSize="10.5"
                                                   Foreground="{StaticResource TextMuted}" Margin="7,4,7,6" />
                                        <ListBox x:Name="MentionList" Background="Transparent"
                                                 BorderThickness="0" MaxHeight="212"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MouseLeftButtonUp="MentionList_MouseLeftButtonUp">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Row" Background="Transparent"
                                                                        CornerRadius="4">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Row" Property="Background"
                                                                                Value="#F6F5F1" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Row" Property="Background"
                                                                                Value="{StaticResource AccentLight}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="8,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DetailText}"
                                                                   FontSize="10.5" Margin="10,0,0,0"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>

                    <!-- 搜索覆盖层：日期头、列表、编辑区都被盖住，标签行和搜索框保留 -->
                    <Grid x:Name="SearchLayer" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="20"
                          Background="#FFFFFF"
                          Visibility="{Binding IsSearching, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="20,12,20,0" Orientation="Horizontal">
                            <TextBlock Text="{Binding SearchSummaryText}" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            <TextBlock Text="Esc 退出" FontSize="10.5" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="20,12,20,0" Orientation="Horizontal">
                            <RadioButton Content="全部" Style="{StaticResource SearchChip}" GroupName="SearchFilter"
                                         IsChecked="{Binding FilterAllActive}" />
                            <RadioButton Content="任务" Style="{StaticResource SearchChip}" GroupName="SearchFilter"
                                         Margin="6,0,0,0" IsChecked="{Binding FilterTasksActive}" />
                            <RadioButton Content="随记" Style="{StaticResource SearchChip}" GroupName="SearchFilter"
                                         Margin="6,0,0,0" IsChecked="{Binding FilterNotesActive}" />
                            <RadioButton Content="只看未完成" Style="{StaticResource SearchChip}" GroupName="SearchFilter"
                                         Margin="6,0,0,0" IsChecked="{Binding FilterOpenActive}" />
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="20,12,20,8">
                            <ListBox x:Name="SearchList" ItemsSource="{Binding SearchResults}"
                                     ItemContainerStyle="{StaticResource TaskListItem}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoSearchHits, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="没有找到匹配的内容" FontSize="13"
                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="换个关键词，或放宽筛选条件" FontSize="11.5"
                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ShowSearchGuide, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="输入关键词，翻遍所有日期" FontSize="13"
                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="任务标题与标签、随记正文 · 空格分隔多个词" FontSize="11.5"
                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" Background="#FCFCFB" MinHeight="32">
                            <Grid>
                                <Border Height="0.5" VerticalAlignment="Top" Background="#E8E6E0" />
                                <TextBlock Text="↑↓ 选择 · Enter 跳转 · Esc 退出搜索" FontSize="10.5"
                                           Foreground="{StaticResource TextMuted}" Margin="20,9" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Full-text card. It lives inside the window instead of being a second
                 Window: no extra taskbar entry, no separate Alt+Tab target, and the
                 rounded shell clips it like everything else. -->
            <Grid x:Name="DetailLayer" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="50"
                  KeyboardNavigation.TabNavigation="Cycle"
                  Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolVis}}">
                <Border Background="#2C2C2A" Opacity="0.18"
                        MouseLeftButtonDown="DetailBackdrop_MouseDown" />

                <Border Width="410" MaxHeight="420"
                        Background="#FFFFFF" BorderBrush="#D3D1C7" BorderThickness="0.5"
                        CornerRadius="12" Padding="16,14"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="3" CornerRadius="1.5" Margin="0,2,10,0"
                                Background="{Binding DetailRow.PriorityBrush}" />

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel>
                                <!-- A read-only TextBox, not a TextBlock: a long task is usually
                                     something to copy out, so the text has to be selectable. -->
                                <TextBox x:Name="DetailTitle"
                                         Text="{Binding DetailRow.Title, Mode=OneWay}"
                                         IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                         Padding="0" Margin="0,0,18,0"
                                         FontSize="15" VerticalContentAlignment="Top"
                                         FocusVisualStyle="{x:Null}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetailRow.IsDone}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <WrapPanel Margin="0,12,0,0">
                                    <Border Background="{Binding DetailRow.BadgeBack}" CornerRadius="4"
                                            Padding="6,2" Margin="0,0,6,4"
                                            Visibility="{Binding DetailRow.HasBadge, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding DetailRow.BadgeText}" FontSize="10.5"
                                                   Foreground="{Binding DetailRow.BadgeFore}" />
                                    </Border>
                                    <Border Background="{Binding DetailRow.PriorityBack}" CornerRadius="4"
                                            Padding="6,2" Margin="0,0,6,4">
                                        <TextBlock Text="{Binding DetailRow.PriorityText}" FontSize="10.5"
                                                   Foreground="{Binding DetailRow.PriorityFore}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding DetailRow.Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource ChipBrush}" CornerRadius="4"
                                                        Padding="6,2" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding}" FontSize="10.5"
                                                               Foreground="{StaticResource TextSecondary}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>

                                <Border Height="0.5" Background="{StaticResource LineBrush}" Margin="0,9,0,0" />
                                <TextBlock Text="{Binding DetailRow.DetailMetaText}" FontSize="11.5"
                                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                           Margin="0,9,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Column="0" Grid.ColumnSpan="2"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-6,-6,0" Style="{StaticResource CardCloseButton}"
                                Click="DetailClose_Click" ToolTip="关闭（Esc）">
                            <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="#8A8880" StrokeThickness="1.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
