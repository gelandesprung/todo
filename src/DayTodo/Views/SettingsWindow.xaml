<Window x:Class="DayTodo.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560" Height="668" MinWidth="520" MinHeight="540"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#DDDBD4" BorderThickness="0.5" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{StaticResource PanelBrush}"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Grid.ColumnSpan="2" Height="0.5" VerticalAlignment="Bottom"
                        Background="#E8E6E0" />

                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="4" Background="{StaticResource Accent}">
                        <Grid>
                            <Rectangle Height="1.2" Fill="#FFFFFF" VerticalAlignment="Top" Margin="3,3,3,0" />
                            <Rectangle Height="1.2" Fill="#FFFFFF" VerticalAlignment="Center" Margin="3,0" />
                            <Rectangle Height="1.2" Fill="#FFFFFF" VerticalAlignment="Bottom" Margin="3,0,3,3" />
                        </Grid>
                    </Border>
                    <TextBlock Text="设置" FontSize="12.5" Margin="9,0,0,0"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource TitleBarButton}"
                        Click="Close_Click" ToolTip="关闭" Width="30" Height="30">
                    <Path Data="M 1,1 L 10,10 M 10,1 L 1,10" Stroke="#5F5E5A" StrokeThickness="1.1" />
                </Button>
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="18,16,18,4">
                <StackPanel>

                    <!-- 通用 -->
                    <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="通用" Style="{StaticResource SectionTitle}" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="开机自启" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="登录 Windows 后自动启动，启动后直接进托盘"
                                               Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                                          ToolTip="写入 HKCU\...\Run 注册表项" />
                            </Grid>

                            <Rectangle Height="0.5" Fill="#EFEDE8" Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="关闭窗口时最小化到托盘" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="关闭后继续在后台运行，任务不会丢；关掉此开关则直接退出"
                                               Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- MCP 服务 -->
                    <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="MCP 服务" Style="{StaticResource SectionTitle}" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="启用 MCP 服务" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="{Binding McpStatusText}" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding McpEnabled, Mode=TwoWay}"
                                          ToolTip="开启后 AI 客户端可创建任务" />
                            </Grid>

                            <Rectangle Height="0.5" Fill="#EFEDE8" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="端口" Style="{StaticResource SettingLabel}" />
                                <TextBox x:Name="PortBox" Grid.Column="1" Style="{StaticResource SettingTextBox}"
                                         Text="{Binding McpPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="PortBox_LostFocus" KeyDown="PortBox_KeyDown"
                                         ToolTip="默认 8765，只监听 127.0.0.1" />
                            </Grid>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="访问令牌" Style="{StaticResource SettingLabel}" />
                                <TextBox x:Name="TokenBox" Grid.Column="1" Style="{StaticResource SettingTextBox}"
                                         Text="{Binding McpToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="TokenBox_LostFocus" KeyDown="TokenBox_KeyDown"
                                         ToolTip="留空表示不校验；填写后请求需带 Authorization: Bearer 令牌" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="连接地址" Style="{StaticResource SettingLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding McpEndpoint}" Margin="0,0,10,0"
                                           Style="{StaticResource SettingValue}" />
                                <Button Grid.Column="2" Content="复制" Style="{StaticResource RowActionButton}"
                                        Command="{Binding CopyEndpointCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 数据 -->
                    <Border Style="{StaticResource SettingCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="数据" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="任务记录" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="纯文本 JSON，可直接复制或用其他工具加工"
                                       Style="{StaticResource SettingHint}" />
                            <TextBlock Text="{Binding DataFilePath}" Style="{StaticResource SettingHint}"
                                       FontSize="10.5" />

                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button Content="打开记录所在位置" Style="{StaticResource SubtleButton}"
                                        Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                                <Button Content="打开备份目录" Style="{StaticResource SubtleButton}"
                                        Command="{Binding OpenBackupFolderCommand}" />
                            </StackPanel>

                            <Rectangle Height="0.5" Fill="#EFEDE8" Margin="0,12,0,10" />

                            <TextBlock Text="备份" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="每次保存留一份备份，最多保留 7 份；记录损坏时自动回滚到最近一份"
                                       Style="{StaticResource SettingHint}" />
                            <TextBlock Text="{Binding BackupDirPath}" Style="{StaticResource SettingHint}"
                                       FontSize="10.5" />
                        </StackPanel>
                    </Border>

                    <!-- 关于 -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="按天显示的轻量清单，未完成任务自动顺延到今天"
                                       Style="{StaticResource SettingHint}" />
                            <Button Content="退出 DayTodo" Style="{StaticResource DangerButton}"
                                    Command="{Binding ExitAppCommand}" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Grid Grid.Row="2" Background="{StaticResource PanelBrush}">
                <Border Height="0.5" VerticalAlignment="Top" Background="#E8E6E0" />
                <Button Content="完成" Style="{StaticResource PrimaryButton}" Width="84" Height="30"
                        HorizontalAlignment="Right" Margin="0,0,18,14" Click="Done_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
